{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": {
    "github:dagger/nix#packages.aarch64-darwin.dagger": {
      "platforms": ["aarch64-darwin"]
    },
    "github:dagger/nix#packages.x86_64-darwin.dagger": {
      "platforms": ["x86_64-darwin"]
    },
    "github:dagger/nix#packages.aarch64-linux.dagger": {
      "platforms": ["aarch64-linux"]
    },
    "github:dagger/nix#packages.x86_64-linux.dagger": {
      "platforms": ["x86_64-linux"]
    },
    "grpcurl": "latest",
    "bun": "latest",
    "xh": "latest",
    "ducker": "latest",
    "dotnet-sdk": "latest"
  },
  "env": {
    "_EXPERIMENTAL_DAGGER_RUNNER_HOST": "docker-container://dagger-engine-v0.21.9",
    "FUSEKI_URL": "https://fuseki-elf-pavlik-dev.apps.rm1.0a51.p1.openshiftapps.com/ds"
  },
  "shell": {
    "init_hook": ["echo 'Welcome to devbox!' > /dev/null"],
    "scripts": {
      "up": "dagger call temporal-with-ui --source=. up --ports=8080:8080",
      "dump": "dagger call export-dump --source=. -o ./ui/public/",
      "wipe": "curl -X POST \"$FUSEKI_URL/update\" -H 'Content-Type: application/sparql-update' --data 'CLEAR ALL'",
      "seed": [
        "curl -X POST \"$FUSEKI_URL/data\" -H 'Content-Type: application/n-quads' --data-binary @ui/public/dump.nq",
        "curl -X POST \"$FUSEKI_URL/data\" -H 'Content-Type: text/turtle' --data-binary @data/software.ttl",
        "curl -X POST \"$FUSEKI_URL/data\" -H 'Content-Type: text/turtle' --data-binary @data/use-cases.ttl"
      ],
      "generate": "bun gen.ts",
      "build": "devbox run generate && dotnet build dotnet/Worker/Worker.csproj",
      "test": ["echo \"Error: no test specified\" && exit 1"]
    }
  }
}
