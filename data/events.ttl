# Sample events from the SDO calendars.
#
# Each record is typed ex:Event and linked to its standards body with ex:sdo.
# Dates use xsd:dateTime in UTC. For events published as local calendar dates,
# multi-day boundaries are 00:00:00Z and 23:59:59Z so the date survives without
# a timezone.
#
# Sources:
#   https://www.w3.org/news-events/tpac/2026/
#   https://www.ietf.org/meeting/127/
#   https://internetidentityworkshop.com/upcoming-events/
#   https://indieweb.org/2026/SD
#   https://atmosphereconf.org/
#   https://fosdem.org/2027/
#   https://events.ccc.de/congress/2026/infos/startpage.html
#
# IIW Foundation operates IIW; https://iiwfoundation.org/ redirects to the
# workshop site, which is the canonical ex:sdo identifier.
#
# Seeded with `devbox run seed` (see devbox.json).

@prefix ex: <http://example.org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:uuid:c59e6390-a817-4f97-83ea-e4053aba9df7> a ex:Event ;
  ex:sdo <https://www.w3.org/> ;
  ex:name "W3C TPAC 2026" ;
  ex:startDate "2026-10-26T00:00:00Z"^^xsd:dateTime ;
  ex:endDate "2026-10-30T23:59:59Z"^^xsd:dateTime ;
  ex:location "Clayton Hotel Burlington Road, Dublin, Ireland" ;
  ex:atLocation <urn:uuid:1166d9bf-85ff-5918-9eb1-3e0b3a5b3390> ;
  ex:source <https://www.w3.org/news-events/tpac/2026/> .

