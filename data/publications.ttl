# Publications and the catalog records they reference.
#
# SDS 2026 paper 13 — "DCAT-based Data Discovery in Solid-based Dataspaces",
# presented at the Fourth International Workshop on Semantics in Dataspaces
# (SDS 2026), co-located with ESWC 2026, Dubrovnik, Croatia, 10 May 2026.
#
# Source: https://drive.google.com/file/d/1-PfRwyZwbStpAq5HCWVeoIHdYInHtMMk/view
#
# Authors are linked to their catalog people nodes. Five of the six authors
# already come from the W3C dump; Tobias Meisen has no W3C account, so the
# ORCID record is used as the stable person URI.
#
# The bibliography points at W3C, Solid and Eclipse specifications. DCAT 3,
# Architecture of the World Wide Web and SHACL already come from the W3C
# crawl; the older W3C Recommendations (LDP, RDF Schema, SKOS, WebID) are
# added here because they are not part of the W3C API dump. The living Solid
# Community Group documents now live in data/solid/specs.ttl, and the Eclipse
# Dataspace Protocol comes from data/eclipse/specs.ttl. The paper's formal
# Solid references and the three Solid work items linked in footnotes (Type
# Indexes, SAI, Shape Trees) all target the canonical nodes in data/solid,
# so no specification is duplicated here.
#
# Seeded by `devbox run seed` (all/static) or explicitly in either environment:
#   devbox run seed:publications
#   devbox run seed:publications -- production
#
# Paper license: CC BY 4.0.

@prefix ex: <http://example.org#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

<https://drive.google.com/file/d/1-PfRwyZwbStpAq5HCWVeoIHdYInHtMMk> a ex:Publication ;
  ex:name "DCAT-based Data Discovery in Solid-based Dataspaces" ;
  dcterms:abstract "Solid-based dataspaces lack an interoperable, standards-based mechanism for discovering datasets offered by dataspace participants. The paper proposes the Solid DCAT Profile to establish a standards-based, privacy-preserving, catalog-centric discovery mechanism by aligning Solid's resource-centric paradigm with DCAT's dataset-centric model. It enables hosting the catalog on a Solid storage, independently managing access control for catalog resources and source data, discovering resources stored on Solid storages as well as externally stored resources, and following the follow-your-nose approach of the RESTful Web architecture." ;
  ex:venue "The Fourth International Workshop on Semantics in Dataspaces (SDS 2026), ESWC 2026, Dubrovnik, Croatia" ;
  dcterms:date "10 May 2026" ;
  ex:url <https://drive.google.com/file/d/1-PfRwyZwbStpAq5HCWVeoIHdYInHtMMk/view> ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:creator
    <urn:uuid:fe30a72f-505c-4f2c-8af8-6bb65addc77d> , # Lukas Kubelka (W3C)
    <urn:uuid:618a13d7-92f8-4ba9-bb17-866329c57b6c> , # Florian Hölken (W3C)
    <urn:uuid:f41d7481-3971-45b1-b647-bbb68abc6d90> , # Christoph Braun (W3C)
    <urn:uuid:5db70d89-b857-4de3-a517-e408bc881e47> , # André Pomp (W3C)
    <https://orcid.org/0000-0002-1969-559X> ,       # Tobias Meisen (ORCID)
    <urn:uuid:cf39ac7e-0081-4b1c-817d-9249da9e8f12> ; # Tobias Käfer (W3C)
  dcterms:references
    <https://www.w3.org/TR/vocab-dcat-3/> ,
    <https://www.w3.org/TR/ldp/> ,
    <https://www.w3.org/TR/webarch/> ,
    <https://www.w3.org/2005/Incubator/webid/spec/identity/> ,
    <https://solidproject.org/TR/protocol> ,
    <https://solidproject.org/TR/oidc> ,
    <https://solidproject.org/TR/wac> ,
    <https://solidproject.org/TR/acp> ,
    # The paper cites these three in footnotes. Their footnote URLs are mapped
    # to the existing canonical specification nodes, not repeated as specs:
    # SAI:        https://solid.github.io/data-interoperability-panel/specification/
    # Shape Trees: https://shapetrees.org/TR/specification/
    <https://solid.github.io/type-indexes/> ,
    <https://solidproject.org/TR/sai> ,
    <https://shapetrees.github.io/specification/> ,
    <https://www.w3.org/TR/rdf11-schema/> ,
    <https://www.w3.org/TR/skos-reference/> ,
    <https://www.w3.org/TR/shacl/> ,
    <https://eclipse-dataspace-protocol-base.github.io/DataspaceProtocol/> ,
    <https://github.com/tmdt-buw/semantic-data-catalog> .

# No W3C account is known for this author; ORCID is the durable identifier.
<https://orcid.org/0000-0002-1969-559X> a ex:Person ;
  ex:name "Tobias Meisen" .

