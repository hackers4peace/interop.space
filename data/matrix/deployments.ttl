# Matrix managed-hosting deployments.
#
# Source: https://matrix.org/ecosystem/hosting/
# These are ex:Server records, not doap:Project software records: the
# hosting directory lists providers of managed Matrix homeservers. They
# share the deployment view with the FediDB server exports.
# Snapshot: 2026-11-13.
#
# Seeded with `devbox run seed -- static` (see scripts/fuseki.ts).

@prefix ex: <http://example.org#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://communick.com/> a ex:Server ;
  ex:siloId "urn:matrix:hosting:communick" ;
  ex:name "Communick" ;
  ex:domain "communick.com" ;
  ex:homepage <https://communick.com> ;
  ex:logo <https://matrix.org/ecosystem/hosting/communick.png> ;
  ex:since "2018"^^xsd:gYear ;
  ex:audience "Individuals" ;
  ex:description "Communick is a service provider for open source messaging and social media platforms. Hosted in Germany, it provides fully managed Synapse homeservers for those looking to be in control of their media presence and also provides a flagship instance at matrix.communick.com for subscribers that value decentralization and are just looking for a stable, less popular server. As a form to support open source, Communick pledges to give 20% of its profits to the open source projects that it offers, so by becoming a customer you'll be also directly ensuring the continued development of the Matrix ecosystem. For information about different hosting plans, please check our Matrix service webpage ." ;
  ex:source <https://matrix.org/ecosystem/hosting/communick/> ;
  dcterms:source <https://matrix.org/ecosystem/hosting/> .

<https://datanauten.de/> a ex:Server ;
  ex:siloId "urn:matrix:hosting:datanauten" ;
  ex:name "Datanauten" ;
  ex:domain "datanauten.de" ;
  ex:homepage <https://datanauten.de/> ;
  ex:logo <https://matrix.org/ecosystem/hosting/datanauten.png> ;
  ex:since "2022"^^xsd:gYear ;
  ex:audience "Individuals" ;
  ex:audience "Business" ;
  ex:description "Hosted Homeservers Bridge Solutions: Installation and configuration of Bridges including Slack, Teams, Telegram, and WhatsApp. The Datanauten Matrix Homeserver offers an easy entry into the open and interoperable communication system of the future." ;
  ex:source <https://matrix.org/ecosystem/hosting/datanauten/> ;
  dcterms:source <https://matrix.org/ecosystem/hosting/> .

<https://etke.cc/> a ex:Server ;
  ex:siloId "urn:matrix:hosting:etke" ;
  ex:name "etke.cc" ;
  ex:domain "etke.cc" ;
  ex:homepage <https://etke.cc> ;
  ex:logo <https://matrix.org/ecosystem/hosting/etke.cc.png> ;
  ex:since "2021"^^xsd:gYear ;
  ex:audience "Individuals" ;
  ex:audience "Business" ;
  ex:description "Hosted Homeservers Cloud or on-premises (BYOS) Fully FOSS (based on matrix-docker-ansible-deploy ). See our code Per-complexity pricing (not per-user) 15+ Matrix bridges & bots Matrix addons (S3, SSO, workers, etc.) 15+ Non-Matrix addons (email, VPN, etc.) Fully-managed, but still yours (root SSH) etke.cc is the only fully FOSS-based Matrix Hosting service. It's operated by a team of active members of the self-hosting community. Based on matrix-docker-ansible-deploy , but hassle-free (SaaS) and contains improvements, extra addons and support . Get hosted on rented servers or use your own infra (on any provider) in a non-vendor-lock-in way. Matrix Space | Announcements on Matrix" ;
  ex:source <https://matrix.org/ecosystem/hosting/etke/> ;
  dcterms:source <https://matrix.org/ecosystem/hosting/> .

<https://fairkom.eu/> a ex:Server ;
  ex:siloId "urn:matrix:hosting:fairkom" ;
  ex:name "fairkom" ;
  ex:domain "fairkom.eu" ;
  ex:homepage <https://fairkom.eu> ;
  ex:logo <https://matrix.org/ecosystem/hosting/fairkom_4c_quer.svg> ;
  ex:since "2015"^^xsd:gYear ;
  ex:audience "Business" ;
  ex:description "Hosting (large) homeservers Consulting for Matrix based messenger solutions Customization of clients and apps Voice & video call integration Standard and custom bridges Scalable deployments on kubernetes On premise deployment and operations support Integration with Identity Management Systems fairkom has been building and hosting chat solutions with various open source frameworks. We are now focussing on Matrix based solutions as interoperability is a key demand of customers and users. Our largest deployment scales for half a million pupils, for whom we developed an app for smartphones with additional educational features. Hosting is climate neutral and GDPR compliant. Try fairmatrix" ;
  ex:source <https://matrix.org/ecosystem/hosting/fairkom/> ;
  dcterms:source <https://matrix.org/ecosystem/hosting/> .

<https://federated.computer/> a ex:Server ;
  ex:siloId "urn:matrix:hosting:federated-computer" ;
  ex:name "Federated Computer" ;
  ex:domain "federated.computer" ;
  ex:homepage <https://federated.computer> ;
  ex:logo <https://matrix.org/ecosystem/hosting/federated.png> ;
  ex:since "2022"^^xsd:gYear ;
  ex:audience "Individuals" ;
  ex:audience "Business" ;
  ex:description "Hosted Homeservers Federated Computer provides Element and Matrix hosting as part of a team collaboration suite (including Nextcloud, Jitsi, Listmonk, Vaultwarden, Baserow, Gitea, Caddy, Castopod, Wireguard, and single-sign-on LDAP)." ;
  ex:source <https://matrix.org/ecosystem/hosting/federated-computer/> ;
  dcterms:source <https://matrix.org/ecosystem/hosting/> .

<https://hostsharing.net/> a ex:Server ;
  ex:siloId "urn:matrix:hosting:hostsharing" ;
  ex:name "Hostsharing eG" ;
  ex:domain "hostsharing.net" ;
  ex:homepage <https://hostsharing.net> ;
  ex:logo <https://matrix.org/ecosystem/hosting/hostsharing-logo.svg> ;
  ex:since "2000"^^xsd:gYear ;
  ex:audience "Individuals" ;
  ex:audience "Business" ;
  ex:description "Hostsharing eG is a German cooperative that operates its own servers in data centres in Germany. The cooperative offers its members comprehensive, one-stop IT solutions. Members can sign up for a customised, managed Matrix solution. The offer includes storage replication to standby servers and remote backup. The service is available in Germany and the European Union." ;
  ex:source <https://matrix.org/ecosystem/hosting/hostsharing/> ;
  dcterms:source <https://matrix.org/ecosystem/hosting/> .

<https://indiehosters.net/> a ex:Server ;
  ex:siloId "urn:matrix:hosting:indiehosters" ;
  ex:name "IndieHosters" ;
  ex:domain "indiehosters.net" ;
  ex:homepage <https://indiehosters.net> ;
  ex:logo <https://matrix.org/ecosystem/hosting/indiehosters.png> ;
  ex:since "2016"^^xsd:gYear ;
  ex:audience "Business" ;
  ex:description "Hosted Homeservers Hosted collaborative tools We are a French collective specialized in hosting FOSS software and aimed at building a digital common, with a particular emphasis on collaboration." ;
  ex:source <https://matrix.org/ecosystem/hosting/indiehosters/> ;
  dcterms:source <https://matrix.org/ecosystem/hosting/> .

<https://ossrox.org/> a ex:Server ;
  ex:siloId "urn:matrix:hosting:ossrox" ;
  ex:name "Ossrox" ;
  ex:domain "ossrox.org" ;
  ex:homepage <https://ossrox.org> ;
  ex:logo <https://matrix.org/ecosystem/hosting/ossrox.svg> ;
  ex:since "2022"^^xsd:gYear ;
  ex:audience "Individuals" ;
  ex:audience "Business" ;
  ex:description "Hosted Homeservers Ossrox is a company from Germany dedicated to hosting open-source services. Not only has the company name been derived from the motto \"Open-Source Software Rocks\", but also their corporate culture. The three most important principles of the company are security, privacy and sustainability - thanks to open-source software. In addition to Matrix, Ossrox also provides many other solutions e.g. in the messaging, groupware and web meeting segments." ;
  ex:source <https://matrix.org/ecosystem/hosting/ossrox/> ;
  dcterms:source <https://matrix.org/ecosystem/hosting/> .

<https://matrix.zerocarbon.shop/> a ex:Server ;
  ex:siloId "urn:matrix:hosting:ungleich" ;
  ex:name "Ungleich.ch" ;
  ex:domain "matrix.zerocarbon.shop" ;
  ex:homepage <https://matrix.zerocarbon.shop> ;
  ex:logo <https://matrix.org/ecosystem/hosting/ungleich_zerocarbonmatrix.jpg> ;
  ex:since "2020"^^xsd:gYear ;
  ex:audience "Individuals" ;
  ex:description "Hosted Homeservers Bridge solutions: bridging Slack, Telegram, Whatsapp, IRC and more Customised Matrix development: Custom Authentication/Login, Integration into private networks Zero Carbon Matrix is provided by ungleich.ch in Switzerland, in their own Datacenter (datacenterlight.ch) with a strong focus on sustainability. Operating within a repurposed historic building, they utilise pre-owned server systems, passive cooling techniques, and 100% renewable energy. ungleich.ch also specialises in customised Matrix development for communities and organisations." ;
  ex:source <https://matrix.org/ecosystem/hosting/ungleich/> ;
  dcterms:source <https://matrix.org/ecosystem/hosting/> .
