# Early Linked Web Storage implementations, in DOAP (http://usefulinc.com/ns/doap#).
#
# Source: the Touchstone conformance runs reported at
# https://ebremer.com/lws/conformance (2026-10-19 / 2026-10-21), plus each
# repository's own metadata. Every entry implements lws10-core.
#
# Dependencies use the catalog's own ex:hasDependencyOn predicate (there is no
# DOAP property for them); the Titanium libraries below carry doap:implements
# for the specs they actually implement, which is what lets a pinned spec match
# against a dependency.
#
# Licenses are SPDX identifiers taken from each project's own metadata
# (GitHub license detection, Cargo.toml, composer.json, package.json).
#
# Repositories and the tested build are IRIs (the GitHub repo / commit), never
# blank nodes, so re-posting this file is idempotent.
#
# Seeded with `devbox run seed` (see devbox.json), so the UI reads it from the
# same Fuseki dataset as the W3C + Specref data.

@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix ex: <http://example.org#> .

# Halcyon — 0.9.0 (next, f173c88), conformant.
<urn:uuid:32f1c032-c9a9-4de0-aac3-79703bba03ce> a doap:Project ;
  doap:license "Apache-2.0" ;
  doap:name "Halcyon" ;
  doap:shortdesc "Halcyon: Feature Analysis and Management System for Pathology Imaging" ;
  doap:programming-language "Java" ;
  doap:maintainer <urn:w3c:person:45759> ;
  doap:implements <https://www.w3.org/TR/lws10-core/> ;
  doap:homepage <https://halcyon.is> ;
  doap:repository <https://github.com/halcyon-project/Halcyon> ;
  doap:release <https://github.com/halcyon-project/Halcyon/commit/f173c88> ;
  ex:hasDependencyOn
    <urn:uuid:146f4c12-acaa-483b-90af-2ae688125d7f> , # Titanium JSON-LD
    <urn:uuid:f29630d3-494d-44f9-8f12-e41fe0ea5e75> , # Titanium RDF N-Quads
    <urn:uuid:d5636749-1165-4cbc-937a-2e6e93cf57a6> , # Titanium RDF Dataset Canonicalization
    <urn:uuid:108ea4c4-f819-4cbd-b90e-6e7cef7a0baa> . # Titanium RDF Primitives

<https://github.com/halcyon-project/Halcyon/commit/f173c88> a doap:Version ;
  doap:name "0.9.0" ;
  doap:revision "f173c88" .

