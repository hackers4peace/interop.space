# ---------------------------------------------------------------------------
# Libraries the implementations above depend on (ex:hasDependencyOn).
# Descriptions are each repository's own, and doap:implements names the
# specification the library implements, so a pinned spec can be matched against
# a dependency.
# ---------------------------------------------------------------------------

# Titanium JSON-LD — JSON-LD 1.1 processor, a normative reference of lws10-core.
<urn:uuid:146f4c12-acaa-483b-90af-2ae688125d7f> a doap:Project ;
  doap:license "Apache-2.0" ;
  doap:name "Titanium JSON-LD" ;
  doap:shortdesc "A JSON-LD 1.1 (JSON-based Serialization for Linked Data) Processor & API" ;
  doap:programming-language "Java" ;
  doap:maintainer <https://github.com/filip26> ;
  doap:implements <https://www.w3.org/TR/json-ld11/> ;
  doap:homepage <https://apicatalog.com> ;
  doap:repository <https://github.com/filip26/titanium-json-ld> .

# Titanium RDF N-Quads — RDF 1.2 N-Quads, a normative reference of lws10-core.
<urn:uuid:f29630d3-494d-44f9-8f12-e41fe0ea5e75> a doap:Project ;
  doap:license "Apache-2.0" ;
  doap:name "Titanium RDF N-Quads" ;
  doap:shortdesc "RDF N-Quads reader and writer optimized for efficient parsing, serialization, and handling of large RDF datasets" ;
  doap:programming-language "Java" ;
  doap:maintainer <https://github.com/filip26> ;
  doap:implements <https://www.w3.org/TR/rdf12-n-quads/> ;
  doap:homepage <https://apicatalog.com> ;
  doap:repository <https://github.com/filip26/titanium-rdf-n-quads> .

# Titanium RDF Dataset Canonicalization — implements RDFC 1.0. Note: rdf-canon
# is NOT a normative reference of lws10-core in this catalog, so this library
# never matches a pinned lws10-core.
<urn:uuid:d5636749-1165-4cbc-937a-2e6e93cf57a6> a doap:Project ;
  doap:license "Apache-2.0" ;
  doap:name "Titanium RDF Dataset Canonicalization" ;
  doap:shortdesc "An implementation of W3C Standard RDF Dataset Canonicalization (RDFC 1.0)" ;
  doap:programming-language "Java" ;
  doap:maintainer <https://github.com/filip26> ;
  doap:implements <https://www.w3.org/TR/rdf-canon/> ;
  doap:homepage <https://apicatalog.com> ;
  doap:repository <https://github.com/filip26/titanium-rdf-canon> .

# Titanium RDF Primitives — RDF 1.2 concepts, a normative reference of lws10-core.
<urn:uuid:108ea4c4-f819-4cbd-b90e-6e7cef7a0baa> a doap:Project ;
  doap:license "Apache-2.0" ;
  doap:name "Titanium RDF Primitives" ;
  doap:shortdesc "RDF primitives, Quad, Triple, Graph, Literal, LangString, ..." ;
