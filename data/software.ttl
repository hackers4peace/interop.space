  doap:maintainer <https://github.com/filip26> ;
  doap:implements <https://www.w3.org/TR/rdf12-concepts/> ;
  doap:homepage <https://apicatalog.com> ;
  doap:repository <https://github.com/filip26/titanium-rdf-primitives> .

# The maintainer of the Titanium libraries is not in the W3C data, so the
# GitHub profile is the person IRI; the minimal person record keeps the chip
# readable (and joins to the catalog if he ever arrives from the W3C API).
<https://github.com/filip26> a ex:Person ;
  ex:name "Filip" ;
  ex:siloUsername "github:filip26" ;
  ex:landingPage <https://github.com/filip26> .

<https://github.com/filip26/titanium-json-ld> a doap:GitRepository .
<https://github.com/filip26/titanium-rdf-n-quads> a doap:GitRepository .
<https://github.com/filip26/titanium-rdf-canon> a doap:GitRepository .
<https://github.com/filip26/titanium-rdf-primitives> a doap:GitRepository .

